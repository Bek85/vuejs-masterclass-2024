# Copy to supabase/.env (git-ignored). Read by the Supabase CLI for env(...) values in config.jsonc.
# Google OAuth client: https://console.cloud.google.com/apis/credentials
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-client-secret
